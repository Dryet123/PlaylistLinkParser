<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:PlaylistLinkParser.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="PlaylistLinkParser.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="Tidal Playlist Parser">

    <Design.DataContext>
        <vm:MainViewModel/>
    </Design.DataContext>

    <Grid RowDefinitions="Auto, Auto, Auto, *">
        
        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="10" Margin="10">
            <TextBox Text="{Binding Url}" 
                     Width="450" 
                     Watermark="https://tidal.com/playlist/..."/>
            <Button Command="{Binding ParseCommand}" 
                    Content="Parse Playlist" 
                    IsEnabled="{Binding !IsLoading}"/>
        </StackPanel>

        <Grid Grid.Row="1" ColumnDefinitions="Auto, *" Margin="10, 0, 10, 10">
            <Image Grid.Column="0" 
                   Source="{Binding PlaylistImage}" 
                   Width="100" 
                   Height="100" 
                   Margin="0,0,10,0"/>
            
            <StackPanel Grid.Column="1" Spacing="5">
                <TextBlock Text="{Binding StatusMessage}" Foreground="DarkOrange" FontWeight="SemiBold"/>
                <TextBlock Text="{Binding CurrentPlaylist.Name}" FontWeight="Bold" FontSize="20"/>
                <TextBlock Text="{Binding CurrentPlaylist.Description}" TextWrapping="Wrap" Opacity="0.7"/>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="2" ColumnDefinitions="2*, 2*, 2*, 1*" Margin="10,0,10,5">
            <TextBlock Grid.Column="0" Text="Song Name" FontWeight="Bold" Margin="5"/>
            <TextBlock Grid.Column="1" Text="Artist Name" FontWeight="Bold" Margin="5"/>
            <TextBlock Grid.Column="2" Text="Album Name" FontWeight="Bold" Margin="5"/>
            <TextBlock Grid.Column="3" Text="Duration" FontWeight="Bold" Margin="5"/>
        </Grid>

        <ListBox Grid.Row="3" ItemsSource="{Binding Tracks}" Margin="10,0,10,10">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid ColumnDefinitions="2*, 2*, 2*, 1*">
                        <TextBlock Grid.Column="0" Text="{Binding Title}" TextTrimming="CharacterEllipsis" Margin="5,0,5,0"/>
                        <TextBlock Grid.Column="1" Text="{Binding Artist}" TextTrimming="CharacterEllipsis" Margin="5,0,5,0"/>
                        <TextBlock Grid.Column="2" Text="{Binding Album}" TextTrimming="CharacterEllipsis" Margin="5,0,5,0"/>
                        <TextBlock Grid.Column="3" Text="{Binding Duration}" Margin="5,0,5,0"/>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        
    </Grid>
</Window>